<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Arial,sans-serif;color:#172033;line-height:1.6}
a{text-decoration:none}
header{padding:18px 7%;display:flex;justify-content:space-between;align-items:center;background:#fff}
.logo{font-size:24px;font-weight:bold;color:#5046e5}
nav a{margin-left:22px;color:#172033;font-weight:600;font-size:14px}
.btn{display:inline-block;padding:12px 22px;background:#5046e5;color:#fff;border-radius:7px;font-weight:bold}
.hero{background:linear-gradient(120deg,#eff0ff,#f5fbff);padding:85px 7%;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.hero h1{font-size:52px;line-height:1.15;margin:18px 0}
.hero h1 span{color:#5046e5}
.hero p{color:#667085;margin-bottom:25px}
.shield{font-size:120px;text-align:center;background:#fff;border-radius:25px;padding:45px;box-shadow:0 15px 45px #30308015}
section{padding:70px 7%}
.heading{text-align:center;max-width:650px;margin:0 auto 38px}
.heading h2{font-size:34px;margin-bottom:10px}
.heading p,.card p{color:#667085}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.card{padding:27px;border:1px solid #e7e9f2;border-radius:13px;background:white}
.card .icon{font-size:35px;margin-bottom:12px}
.card h3{margin-bottom:10px}
.light{background:#f7f8fc}
.price{font-size:30px;font-weight:bold;margin:12px 0}
.card ul{padding-left:20px;margin:15px 0;color:#596174}
.cta{text-align:center;background:#25216d;color:white;padding:65px 7%}
.cta p{margin:12px 0 24px;color:#e1e0ff}
.cta .btn{background:white;color:#5046e5}
details{padding:20px;border-bottom:1px solid #e7e9f2}
summary{cursor:pointer;font-weight:bold}
details p{padding-top:12px;color:#667085}
footer{background:#11172a;color:white;text-align:center;padding:30px 7%}
footer p{font-size:13px;color:#bdc4d5;margin-top:10px}
@media(max-width:750px){
 header{flex-wrap:wrap;gap:12px}
 nav{width:100%;display:flex;flex-wrap:wrap;gap:12px}
 nav a{margin:0}
 .hero{grid-template-columns:1fr;padding:55px 6%}
 .hero h1{font-size:40px}
 .shield{font-size:85px;padding:25px}
 .grid{grid-template-columns:1fr}
 section{padding:55px 6%}
 .heading h2{font-size:29px}
}
</style>
</head>
